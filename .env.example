# Variáveis da agenda. Os segredos quem preenche é a equipe.

# ── Código novo (arquitetura do CRM) ─────────────────────────────────────────
# Conexão direta com o Postgres do projeto do CRM (pooler do Supabase), onde mora
# o esquema agenda.
DATABASE_URL=
# Conexões do banco por processo (opcional; padrão 10). A fila tem 2 próprias, e a
# conexão parada há 20 s é devolvida ao pooler, que a agenda divide com o CRM.
DATABASE_MAX_CONEXOES=

# A sessão da tela (o login pelo item de menu). Pelo menos 32 caracteres
# aleatórios; sem ele, ninguém entra pela tela. Gerar com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AGENDA_SEGREDO_SESSAO=
# Os hosts da plataforma que podem abrir a agenda num iframe, separados por
# vírgula (ex.: app.fluxodonto.com). Em produção, sem a lista ninguém entra.
EMBED_HOSTS=

# O CRM (fase 7): o endereço e a chave da agenda na API v1 dele. A chave é do tipo
# integração, com escrita, para todas as clínicas (criada no setup do CRM). Sem
# os dois, os avisos ao CRM esperam na caixa de saída.
CRM_URL=
CRM_CHAVE=
# O endereço público da agenda (ex.: https://agenda.contactia.com.br): ao ligar a
# clínica, a agenda cadastra no CRM o webhook {AGENDA_URL}/api/v1/crm/avisos.
AGENDA_URL=
# Cifra o segredo desse webhook. 32 bytes em base64. Gerar com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AGENDA_CHAVE_CIFRAGEM=

# ── Código antigo: só o onboarding público (sai na migração) ─────────────────
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
JWT_SECRET=
NEXT_PUBLIC_APP_URL=

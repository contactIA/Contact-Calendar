# Variáveis da agenda. Os segredos quem preenche é a equipe.

# ── Código novo (arquitetura do CRM) ─────────────────────────────────────────
# Conexão direta com o Postgres do projeto do CRM (pooler do Supabase), onde mora
# o esquema agenda.
DATABASE_URL=
# Conexões do banco por processo (opcional; padrão 10). A fila tem 2 próprias, e a
# conexão parada há 20 s é devolvida ao pooler, que a agenda divide com o CRM.
DATABASE_MAX_CONEXOES=

# A sessão da tela (o login pelo item de menu). Pelo menos 32 caracteres
# aleatórios; sem ele, ninguém entra pela tela. Gerar com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AGENDA_SEGREDO_SESSAO=
# Os hosts da plataforma que podem abrir a agenda num iframe, separados por
# vírgula (ex.: app.fluxodonto.com). Em produção, sem a lista ninguém entra.
EMBED_HOSTS=

# ── Código antigo (sai na migração) ──────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
JWT_SECRET=
WHITELABEL_AUTH_SECRET=
INTEGRATIONS_ENCRYPTION_KEY=
HELENA_BASE_URL=
FLUXODONTO_URL=
NEXT_PUBLIC_APP_URL=
